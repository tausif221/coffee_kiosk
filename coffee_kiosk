total_bill = 0.00

menu = {
    1: ("Black Coffee", 2.00),
    2: ("Vanilla Latte", 3.00),
    3: ("Caramel Macchiato", 3.25),
    4: ("Blueberry Muffin", 3.50)}

while True:
    print("\n--- Byte & Brew Menu ---")

    for number, (name, price) in menu.items():
        print(f"{number}. {name} - ${price:.2f}")

    print("5. Complete Order (Checkout)")

    try:
        choice = int(input("Enter your choice (1-5): "))
    except ValueError:
        print("Invalid input. Please enter a number.")
        continue

    if choice == 5:
        print(f"\nFinal Total: ${total_bill:.2f}")
        print("Thank you for visiting Byte & Brew!")
        break

    elif choice in menu:
        name, price = menu[choice]
        total_bill += price
        print(f"Added {name}. Current total: ${total_bill:.2f}")

    else:
        print("Invalid selection. Please choose 1-5.")
